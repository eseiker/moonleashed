# Shared vendored NimBLE private lib (host + NPL-over-FURI + glue). Both the GUI
# test FAP and the resident bt plugin build it privately and resolve firmware
# imports via firmware_api_interface.
_nimble_lib = Lib(
    name="nimble",
    fap_include_paths=[
        ".",
        "nimble/include",
        "nimble/host/include",
        "nimble/host/util/include",
        "nimble/host/services/gap/include",
        "nimble/host/services/gatt/include",
        "nimble/host/store/config/include",
        "nimble/transport/include",
        "porting/nimble/include",
        "porting/npl/furi/include",
        "glue",
    ],
    sources=["*.c"],
    # Vendored third-party tree: silence its warnings so -Werror in the
    # firmware build does not fail on upstream NimBLE style.
    cflags=["-w"],
)

# GUI test FAP: foreground on-device NimBLE Serial Service host (TASK-589).
App(
    appid="nimble_host",
    name="NimBLE Host",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nimble_host_app",
    requires=["gui"],
    stack_size=2 * 1024,
    fap_category="Tools",
    fap_version=(0, 3),
    fap_description="On-device NimBLE host: Serial Service peripheral with legacy passkey pairing (TASK-589)",
    sources=["nimble_host_app.c"],
    fap_private_libs=[_nimble_lib],
)

# Resident bt plugin: headless NimBLE host loaded from SD by the firmware bt
# bridge (TASK-594, B4). Exposes the NimbleBtBackend function table.
App(
    appid="nimble_bt",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nimble_bt_ep",
    # Loaded by the firmware bt bridge (RECORD_BT host).
    requires=["bt"],
    sources=["nimble_bt_plugin.c"],
    fap_private_libs=[_nimble_lib],
)
