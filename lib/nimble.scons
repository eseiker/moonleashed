Import("env")

# Apache NimBLE host, built as a firmware static library so the bt service links
# the on-device BLE host directly. Direction: KNOW-597; TASK-599.
#
# lib/nimble is the apache/mynewt-nimble submodule, pinned to nimble_1_10_0_tag
# (TASK-656). It is kept pristine: every Flipper-specific file lives in
# lib/nimble_furi — the plain-C glue the firmware talks to, our syscfg.h, and
# the NPL-over-FURI port. The only NimBLE surface the rest of the firmware
# includes is lib/nimble_furi/glue, which pulls in no NimBLE headers.

nimble_include_paths = [
    # Our syscfg.h must shadow the upstream porting/nimble/include/syscfg one.
    "#/lib/nimble_furi",
    "#/lib/nimble/nimble/include",
    "#/lib/nimble/nimble/host/include",
    "#/lib/nimble/nimble/host/util/include",
    "#/lib/nimble/nimble/host/services/gap/include",
    "#/lib/nimble/nimble/host/services/gatt/include",
    "#/lib/nimble/nimble/host/store/config/include",
    "#/lib/nimble/nimble/transport/include",
    "#/lib/nimble/porting/nimble/include",
    "#/lib/nimble_furi/npl/furi/include",
    "#/lib/nimble_furi/glue",
    # The fixed-CID relay (fixedcid_glue.c, TASK-663) needs NimBLE's private
    # host headers to install an extra fixed L2CAP channel. Only our glue in
    # lib/nimble_furi uses these; upstream is unchanged.
    "#/lib/nimble/nimble/host/src",
]

# Expose only the plain-C glue headers to the rest of the firmware (the bt
# service and furi_ble include <nimble_glue.h> etc.). They pull in no NimBLE
# headers, so they do not leak MYNEWT_VAL macros into the -Wundef build.
env.Append(
    CPPPATH=[
        "#/lib/nimble_furi/glue",
    ],
)

libenv = env.Clone(FW_LIB_NAME="nimble")
libenv.ApplyLibFlags()
libenv.AppendUnique(
    CPPPATH=nimble_include_paths,
    # Upstream tree: silence its warnings so the firmware's -Werror does not
    # trip on NimBLE style. Appended after ApplyLibFlags so -w wins.
    CCFLAGS=["-w"],
    # NimBLE's internal L2CAP CoC uses two symbol names that clash with the
    # Moon-Firmware-compatible public API (ble_l2cap_coc_init / _send) exposed
    # from targets/f7/ble_glue/furi_ble/l2cap_coc.c (KNOW-636). Rename the NimBLE
    # internals across the whole library so the public names are free (KNOW-638).
    CPPDEFINES=[
        ("ble_l2cap_coc_init", "nmbl_l2cap_coc_init"),
        ("ble_l2cap_coc_send", "nmbl_l2cap_coc_send"),
    ],
)

# Host-only subset of the upstream tree. The submodule also carries the
# controller, mesh, apps, other transports and Mynewt-only files
# (ble_gatts_lcl.c needs console/console.h, ble_store_config_conf.c needs
# conf/NVS), so sources are listed rather than globbed.
upstream_sources = [
    "nimble/nimble/host/services/gap/src/ble_svc_gap.c",
    "nimble/nimble/host/services/gatt/src/ble_svc_gatt.c",
    "nimble/nimble/host/src/ble_att.c",
    "nimble/nimble/host/src/ble_att_clt.c",
    "nimble/nimble/host/src/ble_att_cmd.c",
    "nimble/nimble/host/src/ble_att_svr.c",
    "nimble/nimble/host/src/ble_cs.c",
    "nimble/nimble/host/src/ble_dtm.c",
    "nimble/nimble/host/src/ble_eatt.c",
    "nimble/nimble/host/src/ble_eddystone.c",
    "nimble/nimble/host/src/ble_gap.c",
    "nimble/nimble/host/src/ble_gattc.c",
    "nimble/nimble/host/src/ble_gatts.c",
    "nimble/nimble/host/src/ble_hs.c",
    "nimble/nimble/host/src/ble_hs_adv.c",
    "nimble/nimble/host/src/ble_hs_atomic.c",
    "nimble/nimble/host/src/ble_hs_cfg.c",
    "nimble/nimble/host/src/ble_hs_conn.c",
    "nimble/nimble/host/src/ble_hs_flow.c",
    "nimble/nimble/host/src/ble_hs_hci.c",
    "nimble/nimble/host/src/ble_hs_hci_cmd.c",
    "nimble/nimble/host/src/ble_hs_hci_evt.c",
    "nimble/nimble/host/src/ble_hs_hci_util.c",
    "nimble/nimble/host/src/ble_hs_id.c",
    "nimble/nimble/host/src/ble_hs_log.c",
    "nimble/nimble/host/src/ble_hs_mbuf.c",
    "nimble/nimble/host/src/ble_hs_misc.c",
    "nimble/nimble/host/src/ble_hs_mqueue.c",
    "nimble/nimble/host/src/ble_hs_periodic_sync.c",
    "nimble/nimble/host/src/ble_hs_pvcy.c",
    "nimble/nimble/host/src/ble_hs_shutdown.c",
    "nimble/nimble/host/src/ble_hs_startup.c",
    "nimble/nimble/host/src/ble_hs_stop.c",
    "nimble/nimble/host/src/ble_ibeacon.c",
    "nimble/nimble/host/src/ble_iso.c",
    "nimble/nimble/host/src/ble_l2cap.c",
    "nimble/nimble/host/src/ble_l2cap_coc.c",
    "nimble/nimble/host/src/ble_l2cap_sig.c",
    "nimble/nimble/host/src/ble_l2cap_sig_cmd.c",
    "nimble/nimble/host/src/ble_sm.c",
    "nimble/nimble/host/src/ble_sm_cmd.c",
    "nimble/nimble/host/src/ble_sm_lgcy.c",
    "nimble/nimble/host/src/ble_sm_sc.c",
    "nimble/nimble/host/src/ble_store.c",
    "nimble/nimble/host/src/ble_store_util.c",
    "nimble/nimble/host/src/ble_uuid.c",
    "nimble/nimble/host/store/config/src/ble_store_config.c",
    "nimble/nimble/host/util/src/addr.c",
    "nimble/nimble/transport/src/rx_task.c",
    "nimble/nimble/transport/src/transport.c",
    "nimble/porting/nimble/src/endian.c",
    "nimble/porting/nimble/src/mem.c",
    "nimble/porting/nimble/src/nimble_port.c",
    "nimble/porting/nimble/src/os_mbuf.c",
    "nimble/porting/nimble/src/os_mempool.c",
    "nimble/porting/nimble/src/os_msys.c",
]

# Everything Flipper-specific: glue + NPL-over-FURI.
furi_sources = libenv.GlobRecursive("*.c", "nimble_furi")

# ble_sm_alg.c is compiled apart from the list above so the rename below applies
# to its definitions only, not to the callers in ble_sm_sc.c (TASK-698). P-256
# runs on the chip's PKA accelerator, so upstream's two mbedtls ECC functions
# are renamed out of the way; callers keep using the real names and reach
# lib/nimble_furi/glue/sm_alg_pka.c instead. Renamed and uncalled, the mbedtls
# versions are dropped by --gc-sections, and the bignum and ecp code they pull
# in goes with them.
sm_alg_obj = libenv.Object(
    "nimble/nimble/host/src/ble_sm_alg.c",
    CPPDEFINES=list(libenv["CPPDEFINES"])
    + [
        ("ble_sm_alg_gen_key_pair", "nmbl_mbedtls_gen_key_pair"),
        ("ble_sm_alg_gen_dhkey", "nmbl_mbedtls_gen_dhkey"),
    ],
)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", upstream_sources + furi_sources + sm_alg_obj)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
